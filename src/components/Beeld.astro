---
// An image as AVIF where the browser takes it, PNG or WebP otherwise, from the same srcset.
// An image for one side of 1242 alone takes its files from sources for that side, so the other side fetches nothing.
import { type Beeld, LEEG_BEELD } from "../layout";

interface Props {
	beeld: Beeld;
	staticUrl: string;
	class?: string;
	media?: string;
}

const { beeld, staticUrl, class: klasse, media } = Astro.props;
const terug = beeld.terugval ?? "png";
const pad = (achter: string, ext: string) => `${staticUrl}/tekeningen/${beeld.bestand}${achter}.${ext}`;
const reeks = (ext: string) =>
	beeld.kleiner?.length
		? [...beeld.kleiner.map((w) => `${pad(`-${w}`, ext)} ${w}w`), `${pad("", ext)} ${beeld.breedte}w`].join(", ")
		: undefined;
---

<picture>
	<source type="image/avif" media={media} srcset={reeks("avif") ?? pad("", "avif")} sizes={beeld.sizes} />
	{media && <source media={media} srcset={reeks(terug) ?? pad("", terug)} sizes={beeld.sizes} />}
	{
		media ? (
			<img class={klasse} src={LEEG_BEELD} alt="" />
		) : (
			<img class={klasse} src={pad("", terug)} srcset={reeks(terug)} sizes={beeld.sizes} alt="" />
		)
	}
</picture>
