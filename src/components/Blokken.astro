---
// The blocks of one section, or of the part of a section below its cut, each with its own component.
import type { Blok, Entry } from "../layout";
import Faq from "./Faq.astro";
import Knop from "./Knop.astro";
import Logo from "./Logo.astro";
import Reviews from "./Reviews.astro";
import Tekst from "./Tekst.astro";
import Uitklap from "./Uitklap.astro";

interface Props {
	blokken: Blok[];
	// The section the blocks lie in, which names the ids of the FAQ.
	naam: string;
	entry: Entry;
	staticUrl: string;
}

const { blokken, naam, entry, staticUrl } = Astro.props;
---

{blokken.map((blok) =>
	blok.soort === "logo" ? (
		<Logo blok={blok} staticUrl={staticUrl} />
	) : blok.soort === "knop" ? (
		<Knop blok={blok} entry={entry} staticUrl={staticUrl} />
	) : blok.soort === "reviews" ? (
		<Reviews blok={blok} staticUrl={staticUrl} />
	) : blok.soort === "uitklap" ? (
		<Uitklap blok={blok} entry={entry} />
	) : blok.soort === "faq" ? (
		<Faq blok={blok} naam={naam} />
	) : (
		<Tekst blok={blok} entry={entry} />
	),
)}
