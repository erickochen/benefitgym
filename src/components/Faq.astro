---
// The FAQ as an accordion after the W3C pattern, every category closed. A category is a term that holds a question
// of this page, in the order of the terms; a question counts under its first term. Closed parts carry a class, not
// hidden, so a text extractor still reads them. Every measure goes as a custom property, so the column can draw
// narrow rows instead.
import { getEmDashCollection, getTaxonomyTermsWithCacheHint, getTermsForEntries, type PortableTextBlock } from "emdash";
import { PortableText } from "emdash/ui";
import { type Blok, blokKlasse, blokStijl } from "../layout";

interface Props {
	blok: Extract<Blok, { soort: "faq" }>;
}

// The arrow of the round button on a grid of 100 by 100, as the measured page draws it.
const PIJL = "32.59,23.57 32.59,72.87 76.96,48.22";

const { blok } = Astro.props;
const [vragen, termen] = await Promise.all([
	getEmDashCollection("vragen", { where: { pagina: blok.pagina }, orderBy: { volgorde: "asc" } }),
	getTaxonomyTermsWithCacheHint("faq_categorie"),
]);
if (Astro.cache?.enabled) for (const { cacheHint } of [vragen, termen]) Astro.cache.set(cacheHint);
const termVan = await getTermsForEntries(
	"vragen",
	vragen.entries.map((vraag) => vraag.data.id),
	"faq_categorie",
);
const categorieen = termen.data
	.map((term) => ({ term, vragen: vragen.entries.filter((vraag) => termVan.get(vraag.data.id)?.[0]?.id === term.id) }))
	.filter((categorie) => categorie.vragen.length);
// Desktop measures plus the wide ones of the column are design units that faq.css multiplies by the scale; the
// narrow ones are pixels, with the line height as a factor.
const o = blok.ontwerp;
const maten: Record<string, string | number> = {
	x: blok.x,
	w: blok.w,
	boven: blok.boven,
	rij: blok.rij.h,
	lijn: blok.rij.lijn,
	kleur: blok.rij.kleur,
	"label-x": blok.label.x,
	"label-y": blok.label.y,
	"label-w": blok.label.w,
	"icoon-x": blok.icoon.x,
	"icoon-y": blok.icoon.y,
	"icoon-w": blok.icoon.w,
	...(blok.smal
		? {
				"smal-rij": `${blok.smal.rij}px`,
				"smal-knop": `${blok.smal.knop}px`,
				"smal-icoon": `${blok.smal.icoon}px`,
				"smal-ruimte": `${blok.smal.ruimte}px`,
				"smal-korps": `${blok.smal.korps}px`,
				"smal-regel": blok.smal.regel,
			}
		: {}),
	...(o
		? {
				"o-breedte": o.breedte,
				"o-x": o.x,
				"o-w": o.w,
				"o-boven": o.boven,
				"o-rij": o.rij,
				"o-lijn": o.lijn,
				"o-korps": o.korps,
				"o-label-x": o.label.x,
				"o-label-y": o.label.y,
				"o-label-w": o.label.w,
				"o-icoon-x": o.icoon.x,
				"o-icoon-y": o.icoon.y,
				"o-icoon-w": o.icoon.w,
			}
		: {}),
};
const stijl = [blokStijl(blok), ...Object.entries(maten).map(([naam, waarde]) => `--faq-${naam}:${waarde}`)].join(";");
---

<div class:list={["blok", "faq", blokKlasse(blok)]} style={stijl}>
	<div class="faq-lijst">
		{
			categorieen.map(({ term, vragen }, i) => (
				<div class="faq-categorie">
					<h3 class="faq-kop">
						<button type="button" class={`faq-knop s-${blok.label.stijl}`} aria-expanded="false" aria-controls={`faq-${i}`}>
							<span>{term.label}</span>
							<svg viewBox="0 0 100 100" aria-hidden="true">
								<circle cx="50" cy="50" r="50" fill={blok.icoon.vlak} />
								<polygon points={PIJL} fill={blok.icoon.pijl} />
							</svg>
						</button>
					</h3>
					<div id={`faq-${i}`} class="faq-paneel faq-dicht" role="region">
						{vragen.map((vraag, j) =>
							vraag.data.soort === "Inleiding" ? (
								<div class="faq-antwoord" {...vraag.edit.antwoord}>
									<PortableText value={(vraag.data.antwoord as PortableTextBlock[] | undefined) ?? []} />
								</div>
							) : (
								<div class="faq-vraag">
									<h4 class="faq-kop">
										<button type="button" class="faq-vraagknop" aria-expanded="false" aria-controls={`faq-${i}-${j}`}>
											<span {...vraag.edit.vraag}>{vraag.data.vraag}</span>
											<svg viewBox="0 0 100 100" aria-hidden="true">
												<polygon points={PIJL} fill={blok.icoon.vlak} />
											</svg>
										</button>
									</h4>
									<div id={`faq-${i}-${j}`} class="faq-antwoord faq-dicht" {...vraag.edit.antwoord}>
										<PortableText value={(vraag.data.antwoord as PortableTextBlock[] | undefined) ?? []} />
									</div>
								</div>
							),
						)}
					</div>
				</div>
			))
		}
	</div>
</div>

<script>
	import { zetFaq } from "../scripts/faq";

	for (const blok of document.querySelectorAll<HTMLElement>(".faq")) zetFaq(blok);
</script>
