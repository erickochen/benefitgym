---
// The dark band at the foot of every page: link columns from menu primary, the address from the list Gegevens with
// the lines of widget area Footer below it, the profiles from Social plus menu juridisch below.
import {
	getEmDashEntry,
	getMenuWithCacheHint,
	getWidgetAreaWithCacheHint,
	type MenuItem,
	sanitizeHref,
	type SiteSettings,
} from "emdash";
import { adresRegels, GEGEVENS_SLUG, type GegevensData, profielen as profielenVan } from "../gegevens";
import { type FooterLayout, perStand, pixels } from "../layout";
import data from "../layout/algemeen/footer.json";
import { relVan } from "../links";
import { linkVan, type PtBlok, tekstVan } from "../tekstblok";
import { COPYRIGHT, KOLOM_TEKEN, SCHEIDING, SITE_NAME, SOCIAAL, SOCIAAL_KOP } from "../teksten";
import Beeld from "./Beeld.astro";

interface Props {
	// The items of menu primary plus the site settings, which the layout reads once.
	items: MenuItem[];
	settings: Partial<SiteSettings>;
	staticUrl: string;
	/** Distance from the bottom of the page in design units; without it the footer follows the page. */
	onder?: number;
}

const { items, settings, staticUrl, onder } = Astro.props;
const f = data as FooterLayout;
const [juridisch, adres, gegevens] = await Promise.all([
	getMenuWithCacheHint("juridisch"),
	getWidgetAreaWithCacheHint("footer"),
	getEmDashEntry("gegevens", GEGEVENS_SLUG),
]);
if (Astro.cache?.enabled) for (const { cacheHint } of [juridisch, adres, gegevens]) Astro.cache.set(cacheHint);

// A group whose children are all plain links is a column, in menu order.
function kolommenVan(items: MenuItem[]): MenuItem[] {
	return items.flatMap((item) =>
		!item.children.length
			? []
			: item.children.every((kind) => !kind.children.length)
				? [item]
				: kolommenVan(item.children),
	);
}

// The address from Gegevens, then each block of the widget as one line; a block with a link is a link row.
const widgetRegels = (adres.data?.widgets ?? [])
	.filter((widget) => widget.type === "content")
	.flatMap((widget) => (widget.content ?? []) as unknown as PtBlok[])
	.map((blok) => {
		const link = linkVan(blok);
		return { tekst: tekstVan(blok.children), href: link ? sanitizeHref(link) : undefined };
	});
const regels = [...adresRegels(gegevens.entry?.data as GegevensData | undefined), ...widgetRegels];

const profielen = profielenVan(settings.social).map((p) => ({ label: SOCIAAL[p.netwerk], href: p.href }));

// A time zone the browser does not know falls back to UTC rather than breaking every page.
function ditJaar(timeZone: string | undefined) {
	try {
		return new Intl.DateTimeFormat("nl-NL", { year: "numeric", timeZone }).format(new Date());
	} catch {
		return new Intl.DateTimeFormat("nl-NL", { year: "numeric" }).format(new Date());
	}
}
const jaar = ditJaar(settings.timezone);
const onderregel = [
	{ tekst: SITE_NAME, href: undefined },
	...(juridisch.data?.items ?? []).map((item) => ({ tekst: item.label, href: item.url })),
	{ tekst: `${COPYRIGHT} ${jaar}`, href: undefined },
];

const variabelen = Object.entries({
	"--f-hoogte": f.hoogte,
	"--f-inspring": f.inspring,
	"--f-kolom": f.kolom,
	"--f-laatste": f.laatste,
	"--f-rij": f.rij,
	"--f-kop": f.kop,
	"--f-links-boven": f.linkkolom.boven,
	"--f-na-kop": f.linkkolom.naKop,
	"--f-adres-boven": f.adres.boven,
	"--f-logo-w": f.adres.logo.w,
	"--f-logo-h": f.adres.logo.h,
	"--f-na-logo": f.adres.naLogo,
	"--f-regel": f.adres.regel,
	"--f-adres-inspring": f.adres.inspring,
	"--f-na-regels": f.adres.naRegels,
	"--f-sociaal-boven": f.sociaal.boven,
	"--f-onder-boven": f.onder.boven,
	"--f-onder-x": f.onder.x,
	"--f-onder-w": f.onder.w,
	"--f-onder-h": f.onder.h,
	"--f-onder-gat": f.onder.gat,
	"background-color": f.achtergrond,
	...(onder === undefined ? {} : { "--f-op-pagina": `calc(${onder} * var(--s))` }),
})
	.map(([naam, waarde]) => `${naam}:${waarde}`)
	.join(";");
// The narrow footer of the column per breakpoint, which footer.css reads below 1242.
const kolomVars = f.smal
	? perStand(f.smal, (k) => ({
			"fk-vak": k.vak.map(pixels).join(" "),
			"fk-z": String(k.z),
			"fk-kolommen": k.kolommen.map(pixels).join(" "),
			"fk-kolom": pixels(k.kolom),
			"fk-boven": pixels(k.boven),
			"fk-kop": pixels(k.kop),
			"fk-rij": pixels(k.rij),
			"fk-regel": pixels(k.regel),
			"fk-logo-w": pixels(k.logo.w),
			"fk-logo-h": pixels(k.logo.h),
			"fk-na-logo": pixels(k.naLogo),
			"fk-tussen": pixels(k.tussen),
			"fk-onder": k.onder.rand.map(pixels).join(" "),
			"fk-onder-gat": pixels(k.onder.gat),
			"fk-onder-link": pixels(k.onder.link),
		}))
	: undefined;
---

<footer
	class:list={["footer", onder !== undefined && "footer-op-pagina"]}
	style={kolomVars ? `${variabelen};${kolomVars}` : variabelen}
>
	<div class="footer-kolommen">
		{kolommenVan(items).map((groep) => (
			<div class="footer-kolom footer-links">
				<p class={`footer-kop s-${f.stijlen.kop}`}>{`${groep.label}${KOLOM_TEKEN}`}</p>
				{groep.children.map((item) => (
					<a class="footer-rij link" href={item.url} target={item.target} rel={relVan(item.target)}>
						<span class={`s-${f.stijlen.link}`}>{item.label}</span>
					</a>
				))}
			</div>
		))}
		<div class="footer-kolom footer-adres">
			<Beeld beeld={f.adres.logo.beeld} staticUrl={staticUrl} class="footer-logo" />
			{regels.map((regel, i) =>
				regel.href ? (
					<a
						class:list={["footer-rij", "footer-inspring", "link", { "footer-na-regels": i > 0 && !regels[i - 1].href }]}
						href={regel.href}
					>
						<span class={`s-${f.stijlen.link}`}>{regel.tekst}</span>
					</a>
				) : (
					<p class={`footer-regel footer-inspring s-${f.stijlen.adres}`}>{regel.tekst}</p>
				),
			)}
		</div>
		<div class="footer-kolom footer-sociaal">
			{profielen.length > 0 && SOCIAAL_KOP.map((kop) => <p class={`footer-kop s-${f.stijlen.kop}`}>{kop}</p>)}
			{profielen.map((p) => (
				<a class="footer-rij link" href={p.href} target="_blank" rel="noopener">
					<span class={`s-${f.stijlen.link}`}>{p.label}</span>
				</a>
			))}
		</div>
	</div>
	<div class="footer-onder">
		{onderregel.map((deel, i) => (
			<Fragment>
				{i > 0 && <span class={`s-${f.stijlen.klein}`}>{SCHEIDING}</span>}
				{deel.href ? (
					<a class={`link s-${f.stijlen.klein}`} href={deel.href}>
						{deel.tekst}
					</a>
				) : (
					<span class={`s-${f.stijlen.klein}`}>{deel.tekst}</span>
				)}
			</Fragment>
		))}
	</div>
</footer>
