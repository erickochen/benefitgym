---
// One form of the forms plugin, drawn from its definition in the panel in the measured look. The privacy line from
// its widget stands before the button. After a group field the rest follows the choice: a group with room points to
// the planner, a full group or another one asks for the fields of the waiting list.
import { getEmDashCollection, sanitizeHref } from "emdash";
import { DATUM, definitieVan, GROEP, ROUTE, type Veld } from "../formulier";
import { type FormulierLayout, maat } from "../layout";
import data from "../layout/algemeen/formulier.json";
import { datumTegels, groepTegel } from "../tegels";
import { FORMULIER } from "../teksten";
import Beeld from "./Beeld.astro";
import FormulierVeld from "./FormulierVeld.astro";

interface Span {
	text?: string;
	marks?: string[];
}

interface Blok {
	children?: Span[];
	markDefs?: { _key: string; _type: string; href?: string }[];
}

interface Props {
	slug: string;
	// The anchor a link jumps to, on the form itself.
	anker?: string;
	staticUrl: string;
	// The sport whose groups a group field shows.
	sport?: string;
	// The planner a group with room points to.
	planner?: string;
	// The line when no course date is planned.
	geenData?: string;
	privacy: Blok[];
}

const { slug, anker, staticUrl, sport, planner, geenData, privacy } = Astro.props;
const v = data as FormulierLayout;
const definitie = await definitieVan(slug, Astro.locals, Astro.url);
const velden = definitie?.pages.flatMap((pagina) => pagina.fields) ?? [];
const tegelVeld = (naam: string) => velden.some((veld) => veld.type === "radio" && veld.name === naam);
const datums = tegelVeld(DATUM)
	? datumTegels((await getEmDashCollection("cursusdata")).entries.map((entry) => entry.data.datum ?? ""), Date.now())
	: [];
const groepen =
	tegelVeld(GROEP) && sport
		? (await getEmDashCollection("groepen", { where: { sport }, orderBy: { volgorde: "asc" } })).entries.flatMap(
				(entry) => groepTegel(entry.data, sport) ?? [],
			)
		: [];

// Half fields stand in pairs; the fields after a group field wait for its choice. Without a sport the group field
// shows its own options, so nothing waits.
const delen = (lijst: Veld[]) =>
	lijst.reduce<Veld[][]>((uit, veld) => {
		const vorige = uit.at(-1);
		if (veld.width === "half" && vorige?.length === 1 && vorige[0].width === "half") vorige.push(veld);
		else uit.push([veld]);
		return uit;
	}, []);
const groep = sport ? velden.findIndex((veld) => veld.type === "radio" && veld.name === GROEP) : -1;
const voor = delen(groep < 0 ? velden : velden.slice(0, groep + 1));
const na = groep < 0 ? [] : delen(velden.slice(groep + 1));
const gat = (waarde: number) => `gap:${maat(waarde)}`;
// The text styles also set the fill color, which a link would inherit from the line around it.
const link = `color:${v.link.kleur};-webkit-text-fill-color:${v.link.kleur};text-decoration-color:${v.link.streep};text-decoration-thickness:${maat(v.link.dikte)};text-underline-offset:${maat(v.link.afstand)}`;
const hrefVan = (blok: Blok, span: Span) => {
	const href = (blok.markDefs ?? []).find((def) => def._type === "link" && span.marks?.includes(def._key))?.href;
	return href ? sanitizeHref(href) : undefined;
};
// A file field sends its file only as multipart.
const bestanden = velden.some((veld) => veld.type === "file");
// The width goes as a custom property, so the column can stretch the button.
const knop = `--knop-w:${maat(v.knop.w)};height:${maat(v.knop.h)};border-radius:${maat(v.knop.radius)};box-shadow:${v.knop.schaduw}`;
const deelProps = { slug, datums, groepen, sport, geenData };
---

{
	definitie && (
		<form
			id={anker}
			class:list={["formulier", anker && "anker"]}
			method="post"
			action={`${ROUTE}/submit`}
			enctype={bestanden ? "multipart/form-data" : undefined}
			data-formulier={definitie.slug}
			style={gat(v.gat)}
		>
			<input type="hidden" name="formId" value={definitie.slug} />
			{
				definitie.settings.spamProtection === "honeypot" && (
					<div class="formulier-honing" aria-hidden="true">
						<input type="text" name="_hp" tabindex="-1" autocomplete="off" />
					</div>
				)
			}
			{voor.map((deel) => <FormulierVeld velden={deel} {...deelProps} />)}
			{groep >= 0 && (
				<div class="formulier-plek" style={gat(v.gat)}>
					<p class={`s-${v.label}`}>{FORMULIER.uitlegPlek}</p>
					{planner && <a class="formulier-planner" href={sanitizeHref(planner)}>{FORMULIER.planner}</a>}
				</div>
			)}
			{groep >= 0 && (
				<div class="formulier-wacht" style={gat(v.gat)}>
					<p class={`formulier-uitleg vol s-${v.label}`}>{FORMULIER.uitlegVol}</p>
					<p class={`formulier-uitleg anders s-${v.label}`}>{FORMULIER.uitlegAnders}</p>
					{na.map((deel) => <FormulierVeld velden={deel} {...deelProps} />)}
				</div>
			)}
			{privacy.map((blok) => (
				<p class={`formulier-privacy s-${v.klein}`}>
					{(blok.children ?? []).map((span, i, spans) => {
						const href = hrefVan(blok, span);
						if (href) return <a class="formulier-link" href={href} style={link}>{span.text}</a>;
						// The space before a link stands as a text node of its own, as on the measured page; the browser
						// measures it apart, which moves the link a fraction.
						const tekst = span.text ?? "";
						const spatie = spans[i + 1] && hrefVan(blok, spans[i + 1]) ? (tekst.match(/\s+$/)?.[0] ?? "") : "";
						return spatie ? (
							<>
								{tekst.slice(0, -spatie.length)}
								<Fragment set:html="<!-- -->" />
								{spatie}
							</>
						) : (
							tekst
						);
					})}
				</p>
			))}
			{definitie._turnstileSiteKey && <div class="formulier-turnstile" data-sitekey={definitie._turnstileSiteKey} />}
			<button type="submit" class="formulier-knop" style={knop}>
				<Beeld beeld={v.knop.beeld} staticUrl={staticUrl} />
				<span class={`s-${v.knop.stijl}`}>{definitie.settings.submitLabel}</span>
			</button>
		</form>
	)
}
