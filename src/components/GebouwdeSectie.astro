---
// A built section: a dark band over the foot of the drawing above, the heading plus intro beside a form, then room for
// the footer. The content stands at least as tall as measured; in the column it stands in the stack.
import { getWidgetAreaWithCacheHint, sanitizeHref } from "emdash";
import { ANKER_AANMELDEN, ANKER_CONTACT, type Entry, maat, pixels, type Sectie, waarde } from "../layout";
import { linkVan, type PtBlok, tekstVan } from "../tekstblok";
import Beeld from "./Beeld.astro";
import Formulier from "./Formulier.astro";

interface Props {
	sectie: Sectie & { gebouwd: NonNullable<Sectie["gebouwd"]> };
	entry: Entry;
	staticUrl: string;
}

const { sectie, entry, staticUrl } = Astro.props;
const g = sectie.gebouwd;
const { data: widgets, cacheHint } = await getWidgetAreaWithCacheHint("onder_formulier");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const inhoudVan = (titel: string) =>
	(widgets?.widgets.find((widget) => widget.type === "content" && widget.title === titel)?.content ??
		[]) as unknown as PtBlok[];
// The call link is one line: its text plus the first address any part of it links to.
const bellen = inhoudVan(g.bellen);
const belTekst = bellen.map((blok) => tekstVan(blok.children)).join("");
const belLink = bellen.map((blok) => linkVan(blok)).find(Boolean);
const belHref = belLink ? sanitizeHref(belLink) : undefined;
// The contact form is the anchor itself; a sign-up section is its anchor from the top of its content.
const contact = g.formulier === ANKER_CONTACT;
// Every measure goes as a custom property, so the column can set its own.
const maten = [
	`background:${g.dek.kleur}`,
	`--g-dek:${maat(g.dek.h)}`,
	`--g-min:${maat(g.afstand.h + g.dek.h)}`,
	`--g-rand:${maat(g.inhoud.boven)} 0 ${maat(g.inhoud.onder)} ${maat(g.inhoud.links)}`,
	`--g-gat:${maat(g.inhoud.gat)}`,
	`--g-kolom:${maat(g.inhoud.kolom)}`,
	`--g-ruimte:${maat(sectie.hoogte - g.afstand.h)}`,
	`--g-strook:${maat(g.strook.h)}`,
	...(g.kolom
		? [
				`--g-strook-ratio:${g.kolom.strook}`,
				`--t-g-rand:${g.kolom.tablet.rand.map(pixels).join(" ")}`,
				`--t-g-gat:${pixels(g.kolom.tablet.gat)}`,
				`--p-g-rand:${g.kolom.phone.rand.map(pixels).join(" ")}`,
				`--p-g-gat:${pixels(g.kolom.phone.gat)}`,
			]
		: []),
].join(";");
---

<section class="sectie gebouwd" style={maten}>
	<div class="gebouwd-dek" style={`background:${g.dek.kleur}`}></div>
	<div id={contact ? undefined : ANKER_AANMELDEN} class="gebouwd-inhoud" data-volgt={g.afstand.volgt ? "" : undefined}>
		<div class="gebouwd-tekst">
			<h2 class={`s-${g.tekst.kop.stijl}`} {...entry.edit[g.tekst.kop.veld]}>
				{waarde(entry, g.tekst.kop.veld) as string}
			</h2>
			<p
				class={`s-${g.tekst.intro.stijl}`}
				style={`margin-top:${maat(g.tekst.gaten[0])}`}
				{...entry.edit[g.tekst.intro.veld]}
			>
				{waarde(entry, g.tekst.intro.veld) as string}
			</p>
			{belHref && (
				<a
					class="gebouwd-bellen link"
					href={belHref}
					style={`height:${maat(g.tekst.bellen.h)};margin-top:${maat(g.tekst.gaten[1])}`}
				>
					<p class={`s-${g.tekst.bellen.stijl}`}>{belTekst}</p>
				</a>
			)}
		</div>
		<div class="gebouwd-formulier">
			<Formulier
				slug={g.formulier}
				anker={contact ? ANKER_CONTACT : undefined}
				staticUrl={staticUrl}
				sport={g.sport}
				planner={waarde(entry, "planner") as string | undefined}
				geenData={waarde(entry, "aanmelden_geen_data") as string | undefined}
				privacy={inhoudVan(g.privacy)}
			/>
		</div>
	</div>
	<div class="gebouwd-ruimte"></div>
	<div class="gebouwd-strook">
		<Beeld beeld={g.strook.beeld} staticUrl={staticUrl} />
	</div>
</section>

<script>
	// Content that the section follows: its padding plus the taller column, to the next whole pixel.
	for (const inhoud of document.querySelectorAll<HTMLElement>(".gebouwd-inhoud[data-volgt]")) {
		const kolommen = [...inhoud.children] as HTMLElement[];
		const volg = () => {
			const stijl = getComputedStyle(inhoud);
			const hoog = Math.max(...kolommen.map((kolom) => kolom.getBoundingClientRect().height));
			inhoud.style.setProperty(
				"--g-volg",
				`${Math.ceil(Number.parseFloat(stijl.paddingTop) + hoog + Number.parseFloat(stijl.paddingBottom))}px`,
			);
		};
		const kijker = new ResizeObserver(volg);
		for (const kolom of kolommen) kijker.observe(kolom);
	}
</script>
