---
// A link drawn as a button, its text on the measured place inside it. In the column the text is centered, as
// the measured column centers it. The button can show an image of its own there.
import { type Blok, DESKTOP_MEDIA, type Entry, KOLOM_MEDIA, blokKlasse, blokStijl, waarde } from "../layout";
import Beeld from "./Beeld.astro";

interface Props {
	blok: Extract<Blok, { soort: "knop" }>;
	entry: Entry;
	staticUrl: string;
}

const { blok, entry, staticUrl } = Astro.props;
const plek = `${blokStijl(blok)};--radius:calc(${blok.radius} * var(--s));--vulling:${blok.achtergrond}`;
const tekstPlek = `--tekst-left:calc(${blok.tekst.x} * var(--s));--tekst-top:calc(${blok.tekst.y} * var(--s));--tekst-width:calc(${blok.tekst.w} * var(--s))`;
const kolomBeeld = blok.kolom?.tablet.beeld;
---

<a class:list={["blok", "knop", blokKlasse(blok)]} href={waarde(entry, blok.link) as string} style={plek}>
	{blok.beeld && (
		<Beeld
			beeld={blok.beeld}
			staticUrl={staticUrl}
			class={kolomBeeld ? "alleen-desktop" : undefined}
			media={kolomBeeld ? DESKTOP_MEDIA : undefined}
		/>
	)}
	{kolomBeeld && <Beeld beeld={kolomBeeld} staticUrl={staticUrl} class="alleen-kolom" media={KOLOM_MEDIA} />}
	<span class={`s-${blok.stijl}`} style={tekstPlek} {...entry.edit[blok.veld]}>
		{waarde(entry, blok.veld) as string}
	</span>
</a>
