---
// A link drawn as a button, its text on the measured place inside it.
import { type Blok, type Entry, waarde } from "../layout";
import Beeld from "./Beeld.astro";

interface Props {
	blok: Extract<Blok, { soort: "knop" }>;
	entry: Entry;
	staticUrl: string;
}

const { blok, entry, staticUrl } = Astro.props;
const plek = `left:calc(${blok.x} * var(--s));top:calc(${blok.y} * var(--s));width:calc(${blok.w} * var(--s));height:calc(${blok.h} * var(--s));border-radius:calc(${blok.radius} * var(--s));background-color:${blok.achtergrond}`;
const tekstPlek = `left:calc(${blok.tekst.x} * var(--s));top:calc(${blok.tekst.y} * var(--s));width:calc(${blok.tekst.w} * var(--s))`;
---

<a class="blok knop" href={waarde(entry, blok.link) as string} style={plek}>
	{blok.beeld && <Beeld beeld={blok.beeld} staticUrl={staticUrl} />}
	<span class={`s-${blok.stijl}`} style={tekstPlek} {...entry.edit[blok.veld]}>{waarde(entry, blok.veld) as string}</span>
</a>
