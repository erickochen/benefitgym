---
// The logo as a link home; the hidden text names the link.
import type { Blok } from "../layout";
import { SITE_NAME } from "../teksten";
import Beeld from "./Beeld.astro";

interface Props {
	blok: Extract<Blok, { soort: "logo" }>;
	staticUrl: string;
}

const { blok, staticUrl } = Astro.props;
const plek = `left:calc(${blok.x} * var(--s));top:calc(${blok.y} * var(--s));width:calc(${blok.w} * var(--s));height:calc(${blok.h} * var(--s))`;
---

<a class="blok logo" href="/" style={plek}>
	<Beeld beeld={blok.beeld} staticUrl={staticUrl} />
	<span>{SITE_NAME}</span>
</a>
