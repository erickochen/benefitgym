---
// The fixed bar from menu primary on the measured places. It turns white past the first scroll mark plus shows the badge past the second.
// Below 1242 a page with its column shows the bar of the column instead: the badge plus the hamburger with its panel.
import { getMenuWithCacheHint, type MenuItem } from "emdash";
import type { MenuLayout } from "../layout";
import data from "../layout/algemeen/menu.json";
import { MENU, NIEUW_TABBLAD, SITE_NAME, TERUG } from "../teksten";
import Beeld from "./Beeld.astro";

interface Props {
	staticUrl: string;
}

const { staticUrl } = Astro.props;
const m = data as MenuLayout;
const { data: menu, cacheHint } = await getMenuWithCacheHint("primary");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// The seed marks the button plus the login icon with a class; an item with children opens a panel.
function soortVan(item: MenuItem) {
	const klassen = item.cssClasses?.split(/\s+/) ?? [];
	if (klassen.includes("knop")) return "knop";
	if (klassen.includes("inloggen")) return "inloggen";
	return item.children.length ? "uitklap" : "pagina";
}

// What an item with children opens: a group per child with children, plus its own pages as a group under its label.
// Headings show on desktop once the panel holds a real group; the column always shows them. No row goes missing.
const groepenVan = (item: MenuItem) => {
	const groepen: { kop: string; rijen: MenuItem[]; los: boolean }[] = [];
	for (const kind of item.children) {
		const vorige = groepen.at(-1);
		if (kind.children.length) groepen.push({ kop: kind.label, rijen: kind.children, los: false });
		else if (vorige?.los) vorige.rijen.push(kind);
		else groepen.push({ kop: item.label, rijen: [kind], los: true });
	}
	return { metKop: item.children.some((c) => c.children.length), groepen };
};

// Each measured page link keeps its own width, in order; a link added later fits its text. Each panel takes its
// measured place plus column widths in order; a column added later takes the width of the last.
let paginaNr = 0;
let paneelNr = 0;
const items = (menu?.items ?? []).map((item) => {
	const soort = soortVan(item);
	const paneel =
		soort === "uitklap"
			? { nr: paneelNr, maat: m.paneel.panelen[paneelNr++] ?? m.paneel.panelen.at(-1)!, ...groepenVan(item) }
			: undefined;
	return { item, soort, paneel, breedte: soort === "pagina" ? m.pagina.breedtes[paginaNr++] : undefined };
});
const hier = Astro.url.pathname.replace(/(.)\/$/, "$1");
const rel = (item: MenuItem) => (item.target === "_blank" ? "noopener" : undefined);
// The panel of the column: pages as rows, every group as a heading with its rows, then the login plus the button.
type Regel = { pagina: MenuItem } | { groep: { kop: string; rijen: MenuItem[] } };
const lijst = items.flatMap(({ item, soort, paneel }): Regel[] =>
	soort === "pagina" ? [{ pagina: item }] : paneel ? paneel.groepen.map((g) => ({ groep: g })) : [],
);
const inloggen = items.find((i) => i.soort === "inloggen")?.item;
const proef = items.find((i) => i.soort === "knop")?.item;
const p = m.paneel;
const rand = (naam: string, waarden: number[]) =>
	Object.fromEntries(["t", "r", "b", "l"].map((kant, i) => [`--${naam}-${kant}`, waarden[i]]));
// The bar of the column measures in pixels, the same on the tablet plus the phone.
const k = m.mobiel;
const px = (n: number) => `${n}px`;
const pxRand = (waarden: number[]) => waarden.map(px).join(" ");
const ring = (r: { stijl: string; dikte: number; kleur: string }) => `${px(r.dikte)} ${r.stijl} ${r.kleur}`;
const kolom = k
	? {
			"--mobiel-hoogte": px(k.hoogte),
			"--mobiel-rand": px(k.rand),
			"--mobiel-rust": k.kleur.rust,
			"--mobiel-vol": k.kleur.vol,
			"--mobiel-overgang": k.overgang.balk,
			"--mobiel-badge-overgang": k.overgang.badge,
			"--mobiel-badge-w": px(k.badge.w),
			"--mobiel-badge-h": px(k.badge.h),
			"--mobiel-badge-maat": k.badge.maat,
			"--mobiel-badge-plek": k.badge.plek,
			"--mobiel-badge-herhaal": k.badge.herhaal,
			"--hamburger-w": px(k.knop.w),
			"--hamburger-h": px(k.knop.h),
			"--streep-x": px(k.knop.streep.x),
			"--streep-w": px(k.knop.streep.w),
			"--streep-h": px(k.knop.streep.h),
			"--streep-radius": px(k.knop.streep.radius),
			"--streep-kleur": k.knop.streep.kleur,
			"--streep-overgang": k.paneel.hamburger.overgang,
			"--mp-rand": pxRand(k.paneel.rand),
			"--mp-achtergrond": k.paneel.achtergrond,
			"--mp-schaduw": k.paneel.schaduw,
			"--mp-z": k.paneel.z,
			"--mp-kop-h": px(k.paneel.kop.h),
			"--mp-kop-rand": pxRand(k.paneel.kop.rand),
			"--mp-kop-uitlijning": k.paneel.kop.uitlijning,
			"--mp-rij-h": px(k.paneel.rij.h),
			"--mp-rij-rand": pxRand(k.paneel.rij.rand),
			"--mp-rij-uitlijning": k.paneel.rij.uitlijning,
			"--mp-rij-radius": px(k.paneel.rij.radius),
			"--mp-rij-overgang": k.paneel.rij.overgang,
			"--mp-rij-vlak": k.paneel.rij.vlak,
			"--mp-rij-ring": ring(k.paneel.rij.ring),
			"--mp-rij-ring-afstand": px(k.paneel.rij.ring.afstand),
			"--mp-huidig-kleur": k.paneel.huidig.kleur,
			"--mp-huidig-dikte": px(k.paneel.huidig.dikte),
			"--mp-huidig-afstand": px(k.paneel.huidig.afstand),
			"--mp-lijn-boven": px(k.paneel.lijn.boven),
			"--mp-lijn-zij": px(k.paneel.lijn.zij),
			"--mp-lijn-onder": px(k.paneel.lijn.onder),
			"--mp-lijn-h": px(k.paneel.lijn.h),
			"--mp-lijn-kleur": k.paneel.lijn.kleur,
			"--mp-icoon-gat": px(k.paneel.inloggen.gat),
			"--mp-knop-boven": px(k.paneel.knop.boven),
			"--mp-knop-zij": px(k.paneel.knop.zij),
			"--mp-knop-h": px(k.paneel.knop.h),
			"--mp-knop-radius": px(k.paneel.knop.radius),
			"--mp-knop-achtergrond": k.paneel.knop.achtergrond,
			"--mp-knop-ring": ring(k.paneel.knop.ring),
			"--mp-knop-ring-afstand": px(k.paneel.knop.ring.afstand),
			"--terug-w": px(k.terug.w),
			"--terug-h": px(k.terug.h),
			"--terug-rechts": px(k.terug.rechts),
			"--terug-onder": px(k.terug.onder),
			"--terug-achtergrond": k.terug.achtergrond,
			"--terug-radius": k.terug.radius,
			"--terug-schaduw": k.terug.schaduw,
			"--terug-ring": k.terug.ring,
			"--terug-overgang": k.terug.overgang,
			"--terug-z": k.terug.z,
		}
	: {};
// The badge is a background image like the measured one, as AVIF where the browser takes it.
const badgeBeeld = (() => {
	if (!k) return undefined;
	const terug = k.badge.beeld.terugval ?? "png";
	const pad = (ext: string) => `${staticUrl}/tekeningen/${k.badge.beeld.bestand}.${ext}`;
	return `background-image:url("${pad(terug)}");background-image:image-set(url("${pad("avif")}") type("image/avif"), url("${pad(terug)}") type("image/${terug}"))`;
})();
const variabelen = Object.entries({
	...kolom,
	"--menu-z": m.z,
	"--menu-hoogte": m.hoogte,
	"--menu-vast-hoogte": m.vast.hoogte,
	"--balk-x": m.balk.x,
	"--balk-y": m.balk.y,
	"--balk-vast-y": m.vast.boven,
	"--balk-w": m.balk.w,
	"--balk-h": m.balk.h,
	"--uitklap-links": m.uitklap.links,
	"--uitklap-rechts": m.uitklap.rechts,
	"--uitklap-gat": m.uitklap.gat,
	"--chevron": m.uitklap.chevron,
	"--chevron-open": p.chevron.open,
	"--chevron-overgang": p.chevron.overgang,
	...rand("paneel", p.vak.rand),
	"--paneel-gat": p.vak.gat,
	"--paneel-radius": p.vak.radius,
	"--paneel-schaduw": p.vak.schaduw,
	"--paneel-achtergrond": p.vak.achtergrond,
	"--paneel-z": p.vak.z,
	"--kop-h": p.kop.h,
	...rand("kop", p.kop.rand),
	"--kop-uitlijning": p.kop.uitlijning,
	"--rij-h": p.rij.h,
	...rand("rij", p.rij.rand),
	"--rij-uitlijning": p.rij.uitlijning,
	"--rij-radius": p.rij.radius,
	"--rij-overgang": p.rij.overgang,
	"--rij-vlak": p.rij.vlak,
	"--rij-ring": ring(p.rij.ring),
	"--rij-ring-afstand": p.rij.ring.afstand,
	"--knop-voor": m.knop.voor,
	"--knop-w": m.knop.w,
	"--knop-h": m.knop.h,
	"--knop-radius": m.knop.radius,
	"--inloggen-voor": m.inloggen.voor,
	"--inloggen-w": m.inloggen.w,
	"--inloggen-h": m.inloggen.h,
	"--vast-r": m.vast.kleur[0],
	"--vast-g": m.vast.kleur[1],
	"--vast-b": m.vast.kleur[2],
	"--lijn-y": m.vast.lijn.y,
	"--lijn-h": m.vast.lijn.h,
	"--lijn-kleur": m.vast.lijn.kleur,
	"--badge-x": m.badge.x,
	"--badge-y": m.badge.y,
	"--badge-w": m.badge.w,
	"--badge-h": m.badge.h,
	"--menu-overgang": m.overgang,
})
	.map(([naam, waarde]) => `${naam}:${waarde}`)
	.join(";");
---

<style is:inline set:html={`:root{${variabelen}}`} />
<header class="menu" data-breedte={m.breedte} data-vast={m.wissel.vast} data-logo={m.wissel.logo}>
	<div class="menu-binnen">
		<a class="menu-badge link" href="/">
			<Beeld beeld={m.badge.beeld} staticUrl={staticUrl} />
			<span>{SITE_NAME}</span>
		</a>
		<nav class="menu-balk">
			{items.map(({ item, soort, paneel, breedte }) =>
				paneel ? (
					<div class="menu-uitklap-houder">
						<button
							type="button"
							class={`menu-item menu-uitklap s-${m.uitklap.stijl}`}
							aria-expanded="false"
							aria-controls={`menu-paneel-${paneel.nr}`}
						>
							{item.label}
							<svg viewBox="0 0 10 10" aria-hidden="true">
								<path
									d="M1.5 3.5 L5 7 L8.5 3.5"
									fill="none"
									stroke="currentColor"
									stroke-width="1.5"
									stroke-linecap="round"
									stroke-linejoin="round"
								/>
							</svg>
						</button>
						<div
							id={`menu-paneel-${paneel.nr}`}
							class="menu-paneel menu-dicht"
							style={`--paneel-links:${paneel.maat.links};--paneel-boven:${paneel.maat.boven}`}
						>
							{paneel.groepen.map((g, j) => (
								<div
									class="menu-paneel-kolom"
									style={`width:calc(${paneel.maat.kolommen[j] ?? paneel.maat.kolommen.at(-1)} * var(--s))`}
								>
									{paneel.metKop && <div class={`menu-paneel-kop s-${p.kop.stijl}`}>{g.kop}</div>}
									<ul>
										{g.rijen.map((r) => (
											<li>
												<a class={`menu-paneel-rij s-${p.rij.stijl}`} href={r.url} target={r.target} rel={rel(r)}>
													{r.label}
												</a>
											</li>
										))}
									</ul>
								</div>
							))}
						</div>
					</div>
				) : soort === "knop" ? (
					<a class="menu-item menu-knop link" href={item.url} target={item.target} rel={rel(item)}>
						<Beeld beeld={m.knop.beeld} staticUrl={staticUrl} />
						<span class={`s-${m.knop.stijl}`}>{item.label}</span>
					</a>
				) : soort === "inloggen" ? (
					<a class="menu-item menu-inloggen link" href={item.url} target={item.target} rel={rel(item)}>
						<Beeld beeld={m.inloggen.beeld} staticUrl={staticUrl} />
						<span>{item.label}</span>
					</a>
				) : (
					<a
						class:list={["menu-item", "menu-pagina", "link", { "menu-vrij": breedte === undefined }]}
						href={item.url}
						target={item.target}
						rel={rel(item)}
						style={breedte === undefined ? undefined : `width:calc(${breedte} * var(--s))`}
						aria-current={item.url === hier ? "page" : undefined}
					>
						<span class={`s-${m.pagina.stijl}`}>{item.label}</span>
					</a>
				),
			)}
		</nav>
		<div class="menu-lijn"></div>
	</div>
	{k && (
		<nav class="menu-mobiel" aria-label={MENU}>
			<a class="menu-mobiel-badge" href="/" aria-label={SITE_NAME} style={badgeBeeld} />
			<button
				type="button"
				class="menu-hamburger"
				aria-expanded="false"
				aria-controls="menu-mobiel-paneel"
				aria-label={MENU}
			>
				{k.knop.streep.tops.map((top, i) => {
					const open = k.paneel.hamburger.strepen[i];
					return (
						<span
							style={`--top:${px(top)};--open-top:${px(open.top)};--open-transform:${open.transform};--open-opacity:${open.opacity}`}
						/>
					);
				})}
			</button>
			<div id="menu-mobiel-paneel" class="menu-mobiel-paneel menu-dicht">
				<ul>
					{lijst.map((regel) =>
						"pagina" in regel ? (
							<li>
								<a
									class={`menu-mobiel-rij s-${k.paneel.stijl.pagina}`}
									href={regel.pagina.url}
									aria-current={regel.pagina.url === hier ? "page" : undefined}
								>
									{regel.pagina.label}
								</a>
							</li>
						) : (
							<li>
								<div class={`menu-mobiel-kop s-${k.paneel.kop.stijl}`}>{regel.groep.kop}</div>
								<ul>
									{regel.groep.rijen.map((r) => (
										<li>
											<a
												class={`menu-mobiel-rij s-${k.paneel.stijl.rij}`}
												href={r.url}
												aria-current={r.url === hier ? "page" : undefined}
											>
												{r.label}
											</a>
										</li>
									))}
								</ul>
							</li>
						),
					)}
				</ul>
				<hr class="menu-mobiel-lijn" />
				{inloggen && (
					<a
						class={`menu-mobiel-rij menu-mobiel-inloggen s-${k.paneel.stijl.rij}`}
						href={inloggen.url}
						target={inloggen.target}
						rel={rel(inloggen)}
					>
						<Fragment set:html={k.paneel.inloggen.icoon.svg} />
						{inloggen.label}
						{inloggen.target === "_blank" && <span class="menu-verborgen">{NIEUW_TABBLAD}</span>}
					</a>
				)}
				{proef && (
					<a
						class={`menu-mobiel-knop s-${k.paneel.knop.stijl}`}
						href={proef.url}
						target={proef.target}
						rel={rel(proef)}
					>
						{proef.label}
					</a>
				)}
			</div>
		</nav>
	)}
</header>
{k && (
	<button type="button" class="menu-terug" aria-label={TERUG}>
		<Fragment set:html={k.terug.icoon.svg} />
	</button>
)}

<script>
	import { KOLOM_MEDIA } from "../layout";
	import { zetMobiel } from "../scripts/mobiel";
	import { zetPanelen } from "../scripts/panelen";

	// The bar switches where its two scroll marks leave the top of the window. Scrolling up switches it back at the same marks.
	const menu = document.querySelector<HTMLElement>(".menu");
	if (menu) {
		const breedte = Number(menu.dataset.breedte);
		const vast = Number(menu.dataset.vast);
		const logo = Number(menu.dataset.logo);
		// The bar of the column only shows on a page with its column, below 1242.
		const metKolom = document.body.classList.contains("met-kolom");
		const inKolom = matchMedia(KOLOM_MEDIA);
		// The highest page logo that has a box, which the bar of the column follows.
		const paginaLogo = () =>
			[...document.querySelectorAll<HTMLElement>("main a.logo")]
				.filter((a) => a.getClientRects().length)
				.sort((a, b) => a.getBoundingClientRect().top - b.getBoundingClientRect().top)[0];
		const zet = () => {
			// The marks scale with the page, so they are compared in design units.
			const y = (window.scrollY * breedte) / Math.min(window.innerWidth, breedte);
			menu.classList.toggle("vast", y >= vast);
			menu.classList.toggle("met-logo", y >= logo);
			if (!metKolom || !inKolom.matches) return;
			// The bar of the column turns white with its badge once the page logo has left the window, at once without one.
			const merk = paginaLogo();
			menu.classList.toggle("vol", !merk || merk.getBoundingClientRect().bottom <= 0);
		};
		addEventListener("scroll", zet, { passive: true });
		addEventListener("resize", zet);
		zet();
		zetPanelen(menu);
		zetMobiel(menu, paginaLogo);
	}
</script>
