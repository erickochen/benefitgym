---
// One section at its measured height: the drawing with the blocks on top, or an empty built section.
import { type Entry, type Sectie, waarde } from "../layout";
import Knop from "./Knop.astro";
import Logo from "./Logo.astro";
import Tekst from "./Tekst.astro";

interface Props {
	sectie: Sectie;
	entry: Entry;
	slug: string;
	staticUrl: string;
	eerste: boolean;
}

const { sectie, entry, slug, staticUrl, eerste } = Astro.props;
const alt = sectie.alt ? ((waarde(entry, sectie.alt) as string | undefined) ?? "") : "";
---

<section class="sectie" style={`height:calc(${sectie.hoogte} * var(--s))`}>
	{
		sectie.tekening && (
			<img
				class="tekening"
				src={`${staticUrl}/tekeningen/${slug}/${sectie.tekening}`}
				alt={alt}
				loading={eerste ? "eager" : "lazy"}
				decoding="async"
			/>
		)
	}
	{
		sectie.blokken.map((blok) =>
			blok.soort === "logo" ? (
				<Logo blok={blok} staticUrl={staticUrl} />
			) : blok.soort === "knop" ? (
				<Knop blok={blok} entry={entry} staticUrl={staticUrl} />
			) : (
				<Tekst blok={blok} entry={entry} />
			),
		)
	}
</section>
