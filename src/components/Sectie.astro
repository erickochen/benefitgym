---
// One section at its measured height: the drawing with the bands on top, or an empty built section.
// A cut section stacks its upper part, the explainer's text in flow plus the part below, each showing its slice of one drawing.
// Below 1242 the section is a column of its bands and the drawing goes.
import { type Entry, type Sectie, altVan, bandVars, rasterVars } from "../layout";
import Band from "./Band.astro";
import GebouwdeSectie from "./GebouwdeSectie.astro";
import Uitklap from "./Uitklap.astro";

interface Props {
	sectie: Sectie;
	entry: Entry;
	slug: string;
	staticUrl: string;
	eerste: boolean;
}

const { sectie, entry, slug, staticUrl, eerste } = Astro.props;
const alt = altVan(entry, sectie.alts);
const src = sectie.tekening ? `${staticUrl}/tekeningen/${slug}/${sectie.tekening}` : undefined;
const { snede } = sectie;
const uitklapBand = snede ? sectie.banden.find((band) => band.blokken[0]?.soort === "uitklap") : undefined;
const uitklap = uitklapBand?.blokken[0];
const boven = sectie.banden.filter((band) => band !== uitklapBand);
// The first cut-out of the page loads at once, as the drawing of the first section does.
const eersteUitsnede = eerste ? boven.findIndex((band) => band.uitsnede) : -1;
const hoogte = (h: number) => `--hoogte:calc(${h} * var(--s))`;
// The slice of the drawing between two heights, the whole drawing scaled as on an uncut section.
const venster = (vanaf: number) => `top:calc(${-vanaf} * var(--s));height:calc(${sectie.hoogte} * var(--s))`;
---

{
	sectie.gebouwd ? (
		<GebouwdeSectie sectie={{ ...sectie, gebouwd: sectie.gebouwd }} entry={entry} staticUrl={staticUrl} />
	) : snede ? (
		<section class="sectie">
			<div class="sectie-deel" style={hoogte(snede.y)}>
				<div class="tekening-venster">
					<img class="tekening" src={src} alt={alt} loading="lazy" decoding="async" style={venster(0)} />
				</div>
				{boven.map((band, i) => <Band band={band} entry={entry} slug={slug} staticUrl={staticUrl} eerste={i === eersteUitsnede} />)}
			</div>
			{uitklap?.soort === "uitklap" && (
				<div class:list={["band", uitklapBand?.kolom === null && "zonder-kolom"]} style={uitklapBand?.kolom ? bandVars(uitklapBand.kolom) : undefined}>
					<Uitklap blok={uitklap} entry={entry} />
				</div>
			)}
			{snede.y < sectie.hoogte && (
				<div class="sectie-deel" style={hoogte(sectie.hoogte - snede.y)}>
					<div class="tekening-venster">
						<img class="tekening" src={src} alt="" loading="lazy" decoding="async" style={venster(snede.y)} />
					</div>
					{snede.banden.map((band) => <Band band={band} entry={entry} slug={slug} staticUrl={staticUrl} eerste={false} />)}
				</div>
			)}
		</section>
	) : (
		<section
			class:list={["sectie", sectie.raster && "raster"]}
			style={sectie.raster ? `${hoogte(sectie.hoogte)};${rasterVars(sectie.raster)}` : hoogte(sectie.hoogte)}
		>
			{src && <img class="tekening" src={src} alt={alt} loading={eerste ? "eager" : "lazy"} decoding="async" />}
			{boven.map((band, i) => <Band band={band} entry={entry} slug={slug} staticUrl={staticUrl} eerste={i === eersteUitsnede} />)}
		</section>
	)
}
