---
// One section at its measured height: the drawing with the bands on top, or an empty built section. A cut section
// stacks its parts around the explainer's text; below 1242 the section is a column of its bands.
import { type Entry, type Laden, type Sectie, altVan, bandVars, rasterVars } from "../layout";
import Band from "./Band.astro";
import GebouwdeSectie from "./GebouwdeSectie.astro";
import Tekening from "./Tekening.astro";
import Uitklap from "./Uitklap.astro";

interface Props {
	sectie: Sectie;
	entry: Entry;
	slug: string;
	staticUrl: string;
	eerste: boolean;
	// The page has its column below 1242, so the drawing only loads above it.
	kolom: boolean;
}

const { sectie, entry, slug, staticUrl, eerste, kolom } = Astro.props;
const alt = altVan(entry, sectie.alts);
const tekening =
	sectie.tekening && sectie.tekeningMaten
		? { src: `${staticUrl}/tekeningen/${slug}/${sectie.tekening}`, maten: sectie.tekeningMaten }
		: undefined;
const { snede } = sectie;
const uitklapBand = snede ? sectie.banden.find((band) => band.blokken[0]?.soort === "uitklap") : undefined;
const uitklap = uitklapBand?.blokken[0];
const boven = sectie.banden.filter((band) => band !== uitklapBand);
// The cut-outs of the first section load at once, as the drawing of that section does; the rest wait.
const laden: Laden = eerste ? "meteen" : "lazy";
const hoogte = (h: number) => `--hoogte:calc(${h} * var(--s))`;
// The slice of the drawing between two heights, the whole drawing scaled as on an uncut section.
const venster = (vanaf: number) => `top:calc(${-vanaf} * var(--s));height:calc(${sectie.hoogte} * var(--s))`;
---

{sectie.gebouwd ? (
	<GebouwdeSectie sectie={{ ...sectie, gebouwd: sectie.gebouwd }} entry={entry} staticUrl={staticUrl} />
) : snede ? (
	<section class="sectie">
		<div class="sectie-deel" style={hoogte(snede.y)}>
			<div class="tekening-venster">
				{tekening && (
					<Tekening
						src={tekening.src}
						maten={tekening.maten}
						alt={alt}
						eerste={eerste}
						kolom={kolom}
						style={venster(0)}
					/>
				)}
			</div>
			{boven.map((band) => (
				<Band band={band} naam={sectie.naam} entry={entry} slug={slug} staticUrl={staticUrl} laden={laden} />
			))}
		</div>
		{uitklap?.soort === "uitklap" && (
			<div
				class:list={["band", uitklapBand?.kolom === null && "zonder-kolom"]}
				style={uitklapBand?.kolom ? bandVars(uitklapBand.kolom) : undefined}
			>
				<Uitklap blok={uitklap} entry={entry} />
			</div>
		)}
		{snede.y < sectie.hoogte && (
			<div class="sectie-deel" style={hoogte(sectie.hoogte - snede.y)}>
				<div class="tekening-venster">
					{tekening && (
						<Tekening
							src={tekening.src}
							maten={tekening.maten}
							alt=""
							eerste={false}
							kolom={kolom}
							style={venster(snede.y)}
						/>
					)}
				</div>
				{snede.banden.map((band) => (
					<Band band={band} naam={sectie.naam} entry={entry} slug={slug} staticUrl={staticUrl} laden="lazy" />
				))}
			</div>
		)}
	</section>
) : (
	<section
		class:list={["sectie", sectie.raster && "raster"]}
		style={sectie.raster ? `${hoogte(sectie.hoogte)};${rasterVars(sectie.raster)}` : hoogte(sectie.hoogte)}
	>
		{tekening && <Tekening src={tekening.src} maten={tekening.maten} alt={alt} eerste={eerste} kolom={kolom} />}
		{boven.map((band) => (
			<Band band={band} naam={sectie.naam} entry={entry} slug={slug} staticUrl={staticUrl} laden={laden} />
		))}
	</section>
)}
