---
// The explainer as a details element. The summary sits on the measured place of the button; the text lies in flow
// where its section is cut, or hangs as a card. Open on desktop it is a dark band or a white card, in the column a
// white block in flow. A button at its foot closes it again.
import type { PortableTextBlock } from "emdash";
import { PortableText } from "emdash/ui";
import { type Blok, type Entry, blokStijl, plekVan, waarde } from "../layout";
import { INKLAPPEN } from "../teksten";

interface Props {
	blok: Extract<Blok, { soort: "uitklap" }>;
	entry: Entry;
}

const { blok, entry } = Astro.props;
const knop = `${blokStijl(blok)};gap:calc(${blok.pijl.gat} * var(--s))`;
const pijl = `width:calc(${blok.pijl.w} * var(--s));height:calc(${blok.pijl.w} * var(--s))`;
const vak = [
	`--u-ontwerp:${blok.ontwerp}`,
	...(blok.band ? [`--u-links:${blok.band.links}`, `--u-breed:${blok.band.breed}`] : []),
	...(blok.kaart ? [plekVan(blok.kaart)] : []),
].join(";");
---

<details class="uitklap" data-stand={blok.kaart ? "kaart" : "band"}>
	<summary id="uitklap-knop" class={`blok uitklap-knop s-${blok.stijl}`} style={knop}>
		<span {...entry.edit[blok.veld]}>{waarde(entry, blok.veld) as string}</span>
		<svg viewBox="0 0 12 12" aria-hidden="true" style={pijl}>
			<polyline points="1.5,4 6,8.5 10.5,4" fill="none" stroke="currentColor" stroke-width="2"></polyline>
		</svg>
	</summary>
	<div
		class:list={["uitklap-tekst", blok.kaart && "blok"]}
		style={vak}
		role="region"
		aria-labelledby="uitklap-knop"
		tabindex={blok.kaart ? "-1" : undefined}
	>
		<div class="uitklap-vlak">
			<div class="uitklap-kolom">
				<div class="uitklap-inhoud" {...entry.edit[blok.tekst]}>
					<PortableText value={(waarde(entry, blok.tekst) as PortableTextBlock[] | undefined) ?? []} />
				</div>
				<button type="button" class="uitklap-inklappen">
					<span>{INKLAPPEN}</span>
					<svg viewBox="0 0 12 12" aria-hidden="true">
						<polyline points="1.5,8 6,3.5 10.5,8" fill="none" stroke="currentColor" stroke-width="2"></polyline>
					</svg>
				</button>
			</div>
		</div>
	</div>
</details>

<script>
	import { zetUitklap } from "../scripts/uitklap";

	for (const uitklap of document.querySelectorAll<HTMLDetailsElement>("details.uitklap")) zetUitklap(uitklap);
</script>
