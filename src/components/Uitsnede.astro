---
// A cut-out of the drawing for the column, at the full width with its own ratio. Above the column it fetches nothing:
// the cut-outs of the first section come from a source for the column alone, the rest load lazy.
import { KOLOM_MEDIA, type Laden, LEEG_BEELD, type Maten, reeksVan, UITSNEDE_SIZES } from "../layout";

interface Props {
	bestand: string;
	maten: Maten;
	alt: string;
	staticUrl: string;
	laden: Laden;
}

const { bestand, maten, alt, staticUrl, laden } = Astro.props;
const src = `${staticUrl}/tekeningen/${bestand}`;
const srcset = reeksVan(src, maten);
const sizes = srcset ? UITSNEDE_SIZES : undefined;
---

{laden === "meteen" ? (
	<picture>
		<source media={KOLOM_MEDIA} srcset={srcset ?? src} sizes={sizes} />
		<img class="uitsnede" src={LEEG_BEELD} alt={alt} loading="eager" fetchpriority="high" decoding="async" />
	</picture>
) : (
	<img class="uitsnede" src={src} srcset={srcset} sizes={sizes} alt={alt} loading="lazy" decoding="async" />
)}
