---
import { getMenuWithCacheHint, type SiteSettings } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import Footer from "../components/Footer.astro";
import Menu from "../components/Menu.astro";
import Beeld from "../components/Beeld.astro";
import type { StrookInKolom } from "../layout";
import { staticUrl as leesStaticUrl } from "../static";
import "../styles/basis.css";
import "../styles/tekst.css";
import "../styles/menu.css";
import "../styles/footer.css";
import "../styles/reviews.css";
import "../styles/uitklap.css";
import "../styles/faq.css";
import "../styles/gebouwd.css";
import "../styles/formulier.css";
import "../styles/praktisch.css";

interface Props {
	/** The full page title; SEO titles already carry the gym name. */
	title: string;
	description?: string | null;
	canonical?: string | null;
	/** The site settings, read by the page with their cache hint. */
	settings: Partial<SiteSettings>;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
	/** Where the footer sits: its distance to the bottom of the page in design units. */
	footerOnder?: number;
	/** The page has its column below 1242. */
	kolom?: boolean;
	/** The strip below the footer in the column, in the flow of the page. */
	strook?: StrookInKolom;
	/** Only the content, without the bar plus the footer, as the page that does not exist. */
	kaal?: boolean;
}

// Each face carries the family name, weight and style the text styles ask for, so an element matches the same file.
const FONTS = [
	["Interstate Regular", "Interstate-Regular.woff2", 500, "normal"],
	["Interstate Bold", "Interstate-Bold.woff2", 700, "normal"],
	["Interstate Bold Italic", "Interstate-BoldItalic.woff2", 700, "italic"],
	["Interstate BoldItalic", "Interstate-BoldItalic-246.woff2", 700, "normal"],
	["Interstate Black", "Interstate-Black.woff2", 900, "normal"],
	["Interstate BlackItalic", "Interstate-BlackItalic.woff2", 900, "normal"],
	["Interstate Light Regular", "Interstate-Light.woff2", 300, "normal"],
	["Interstate Light Italic", "Interstate-LightItalic.woff2", 300, "italic"],
	["Antique Olive Compact Regular Italic", "AntiqueOliveCompact-Italic.woff2", 400, "italic"],
] as const;
// The two faces above the fold: the hero intro plus the heading and the button.
const PRELOAD = ["Interstate-BlackItalic.woff2", "AntiqueOliveCompact-Italic.woff2"];

const { title, description, canonical, settings, content, footerOnder, kolom, strook, kaal } = Astro.props;
const staticUrl = leesStaticUrl();
const fontCss = FONTS.map(
	([family, file, weight, style]) =>
		`@font-face{font-family:"${family}";src:url("${staticUrl}/fonts/${file}") format("woff2");font-weight:${weight};font-style:${style};font-display:block}`,
).join("");

// The main menu once, for the bar plus the footer; the bare page has neither.
const primary = kaal ? undefined : await getMenuWithCacheHint("primary");
if (primary && Astro.cache?.enabled) Astro.cache.set(primary.cacheHint);
const items = primary?.data?.items ?? [];

// No siteName: with it EmDash adds a bare WebSite block to every page. The structured-data plugin puts the graph on /
// plus og:site_name on every page instead.
const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title,
	pageTitle: title,
	description: description ?? settings.tagline,
	canonical,
	content,
});
---

<!doctype html>
<html lang="nl">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<EmDashHead page={pageCtx} />
		{PRELOAD.map((file) => (
			<link rel="preload" href={`${staticUrl}/fonts/${file}`} as="font" type="font/woff2" crossorigin />
		))}
		<style is:inline set:html={fontCss} />
	</head>
	<body class:list={[kolom && "met-kolom", kaal && "kaal"]}>
		<EmDashBodyStart page={pageCtx} />
		{kaal ? (
			<main class="kaal-inhoud">
				<slot />
			</main>
		) : (
			<Fragment>
				<Menu items={items} staticUrl={staticUrl} />
				<div class="kolom">
					<main>
						<slot />
					</main>
					<Footer items={items} settings={settings} staticUrl={staticUrl} onder={footerOnder} />
				</div>
			</Fragment>
		)}
		{strook && (
			<div
				class="kolom-strook"
				aria-hidden="true"
				style={`--t-ks-ratio:${strook.verhouding.tablet};--p-ks-ratio:${strook.verhouding.phone}`}
			>
				<Beeld beeld={strook.beeld} staticUrl={staticUrl} />
			</div>
		)}
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>

<script>
	// The toolbar of the editor only renders on an edit view; the length guard of live editing loads along with it.
	if (document.getElementById("emdash-toolbar")) void import("../scripts/live-edit").then((m) => m.zetLiveEdit());
</script>
