---
// The page for an address that does not exist, laid out as the measured page: the mark, a heading, a line plus a
// button home. The texts come from widget area Niet gevonden; a block that is one link becomes the button.
import { getSiteSettingsWithCacheHint, getWidgetAreaWithCacheHint, sanitizeHref } from "emdash";
import Base from "../layouts/Base.astro";
import { isEenLink, linkVan, type PtBlok, tekstVan } from "../tekstblok";
import { SITE_NAME } from "../teksten";
import "../styles/niet-gevonden.css";

const [gebied, instellingen] = await Promise.all([
	getWidgetAreaWithCacheHint("niet_gevonden"),
	getSiteSettingsWithCacheHint(),
]);
if (Astro.cache?.enabled) for (const hint of [gebied.cacheHint, instellingen.cacheHint]) Astro.cache.set(hint);
const settings = instellingen.data ?? {};
const widget = (gebied.data?.widgets ?? []).find((w) => w.type === "content");
const kop = widget?.title ?? "";
const regels = ((widget?.content ?? []) as unknown as PtBlok[]).map((blok) => ({
	tekst: tekstVan(blok.children),
	href: isEenLink(blok) ? sanitizeHref(linkVan(blok) ?? "") : undefined,
}));
const siteTitel = settings.title ?? SITE_NAME;
const teken = settings.favicon?.url;
---

<Base title={kop ? `${kop} | ${siteTitel}` : siteTitel} settings={settings} kaal>
	{teken && <img class="niet-gevonden-teken" src={teken} alt="" width="21" height="21" />}
	{kop && <h1 class="niet-gevonden-kop">{kop}</h1>}
	{regels.map((regel) =>
		regel.href ? (
			<a class="niet-gevonden-knop" href={regel.href}>
				{regel.tekst}
			</a>
		) : (
			<p class="niet-gevonden-regel">{regel.tekst}</p>
		),
	)}
</Base>
