---
// The page for an address that does not exist, laid out as the measured page shows it: the mark, a heading, a line
// plus a button home in the middle of an empty page. The texts come from widget area Niet gevonden: the title of its
// widget is the heading, a block that is one link becomes the button.
import { getSiteSettings, getWidgetAreaWithCacheHint, sanitizeHref } from "emdash";
import Base from "../layouts/Base.astro";
import { SITE_NAME } from "../teksten";
import "../styles/niet-gevonden.css";

interface Span {
	text?: string;
	marks?: string[];
}

interface Blok {
	children?: Span[];
	markDefs?: { _key: string; _type: string; href?: string }[];
}

const [gebied, settings] = await Promise.all([getWidgetAreaWithCacheHint("niet_gevonden"), getSiteSettings()]);
if (Astro.cache?.enabled) Astro.cache.set(gebied.cacheHint);
const widget = (gebied.data?.widgets ?? []).find((w) => w.type === "content");
const kop = widget?.title ?? "";
const regels = ((widget?.content ?? []) as unknown as Blok[]).map((blok) => {
	const kinderen = blok.children ?? [];
	const tekst = kinderen.map((kind) => kind.text ?? "").join("");
	const links = (blok.markDefs ?? []).filter((def) => def._type === "link" && def.href);
	// A block whose whole text carries one link is the button; any other block is a line.
	const knop = links.length === 1 && kinderen.every((kind) => kind.marks?.includes(links[0]._key));
	return { tekst, href: knop ? sanitizeHref(links[0].href ?? "") : undefined };
});
const siteTitel = settings.title ?? SITE_NAME;
const teken = settings.favicon?.url;
---

<Base title={kop ? `${kop} | ${siteTitel}` : siteTitel} kaal>
	{teken && <img class="niet-gevonden-teken" src={teken} alt="" width="21" height="21" />}
	{kop && <h1 class="niet-gevonden-kop">{kop}</h1>}
	{regels.map((regel) =>
		regel.href ? (
			<a class="niet-gevonden-knop" href={regel.href}>
				{regel.tekst}
			</a>
		) : (
			<p class="niet-gevonden-regel">{regel.tekst}</p>
		),
	)}
</Base>
