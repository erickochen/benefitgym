---
import { decodeSlug, getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import { SITE_NAME } from "../teksten";

// Fixed order: a Praktisch page with the slug of a sport page loses to it.
const COLLECTIONS = ["sportpaginas", "over_ons", "praktisch"] as const;

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

async function findPage(slug: string) {
	for (const collection of COLLECTIONS) {
		const { entry, cacheHint } = await getEmDashEntry(collection, slug);
		// The loader also matches a database id; only the slug is a page address.
		if (entry && entry.data.id !== slug) return { collection, entry, cacheHint };
	}
	return null;
}

const found = await findPage(slug);
if (!found) return Astro.rewrite("/404");
const { collection, entry, cacheHint } = found;
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// An SEO title carries the gym name already; a page without one gets it behind its title.
const ownTitle = (entry.data as { seo?: { title?: string | null } }).seo?.title;
const settings = await getSiteSettings();
const seo = getSeoMeta(entry, {
	siteTitle: ownTitle ? undefined : (settings.title ?? SITE_NAME),
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});
---

<Base
	title={seo.title}
	description={seo.description}
	canonical={seo.canonical}
	content={{ collection, id: entry.data.id, slug }}
>
	<h1 {...entry.edit.title}>{entry.data.title}</h1>
</Base>
