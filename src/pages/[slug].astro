---
import { decodeSlug, getSiteSettingsWithCacheHint } from "emdash";
import Pagina from "../components/Pagina.astro";
import { strookInKolom, type Layout, type PraktischRegels } from "../layout";
import praktisch from "../layout/algemeen/praktisch.json";
import Base from "../layouts/Base.astro";
import { seoVoor, vindPagina } from "../paginas";
import { staticUrl as leesStaticUrl } from "../static";

// One layout file per page; a page without one shows only its title.
const LAYOUTS = import.meta.glob<Layout>("../layout/*.json", { eager: true, import: "default" });
// A Praktisch page without a drawing of its own takes the hero of this page.
const PRAKTISCH_HERO = "tarieven";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");
const staticUrl = leesStaticUrl();

const gevonden = await vindPagina(slug);
if (!gevonden) return Astro.rewrite("/404");
const { collectie, entry, cacheHint } = gevonden;
const instellingen = await getSiteSettingsWithCacheHint();
if (Astro.cache?.enabled) for (const hint of [cacheHint, instellingen.cacheHint]) Astro.cache.set(hint);
const settings = instellingen.data ?? {};
const eigen = LAYOUTS[`../layout/${slug}.json`];
const bron = eigen || collectie !== "praktisch" ? slug : PRAKTISCH_HERO;
const layout = eigen ?? (collectie === "praktisch" ? LAYOUTS[`../layout/${PRAKTISCH_HERO}.json`] : undefined);
const seo = seoVoor(entry, settings, Astro.url.pathname.replace(/\/$/, ""), Astro.url.origin);
---

<Base
	title={seo.title}
	description={seo.description}
	canonical={seo.canonical}
	settings={settings}
	content={{ collection: collectie, id: entry.data.id, slug }}
	footerOnder={layout?.footer.onder}
	kolom={layout?.kolom === true}
	strook={strookInKolom(layout, praktisch as PraktischRegels)}
>
	{layout ? (
		<Pagina layout={layout} entry={entry} slug={bron} staticUrl={staticUrl} />
	) : (
		<h1 {...entry.edit.title}>{entry.data.title}</h1>
	)}
</Base>
