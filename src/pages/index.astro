---
import { getEmDashEntry, getSiteSettingsWithCacheHint } from "emdash";
import Pagina from "../components/Pagina.astro";
import { strookInKolom, type Layout, type PraktischRegels } from "../layout";
import praktisch from "../layout/algemeen/praktisch.json";
import data from "../layout/home.json";
import Base from "../layouts/Base.astro";
import { seoVoor } from "../paginas";
import { staticUrl as leesStaticUrl } from "../static";

const SLUG = "home";
const layout = data as Layout;

// Home has a fixed slug: the route resolver skips a pattern without one.
const { entry: home, cacheHint } = await getEmDashEntry("home", SLUG);
if (!home) return Astro.rewrite("/404");
const instellingen = await getSiteSettingsWithCacheHint();
if (Astro.cache?.enabled) for (const hint of [cacheHint, instellingen.cacheHint]) Astro.cache.set(hint);
const settings = instellingen.data ?? {};
const seo = seoVoor(home, settings, "/", Astro.url.origin);
---

<Base
	title={seo.title}
	description={seo.description}
	canonical={seo.canonical}
	settings={settings}
	content={{ collection: "home", id: home.data.id, slug: SLUG }}
	footerOnder={layout.footer.onder}
	kolom={layout.kolom === true}
	strook={strookInKolom(layout, praktisch as PraktischRegels)}
>
	<Pagina layout={layout} entry={home} slug={SLUG} staticUrl={leesStaticUrl()} />
</Base>
