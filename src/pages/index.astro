---
import { getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import Pagina from "../components/Pagina.astro";
import type { Layout } from "../layout";
import data from "../layout/home.json";
import Base from "../layouts/Base.astro";
import { staticUrl as leesStaticUrl } from "../static";
import { SITE_NAME } from "../teksten";

const SLUG = "home";
const layout = data as Layout;

// Home has a fixed slug: the route resolver skips a pattern without one.
const { entry: home, cacheHint } = await getEmDashEntry("home", SLUG);
if (!home) return Astro.rewrite("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// An SEO title carries the gym name already; without one the gym name goes behind the title.
const ownTitle = (home.data as { seo?: { title?: string | null } }).seo?.title;
const settings = await getSiteSettings();
const seo = getSeoMeta(home, {
	siteTitle: ownTitle ? undefined : (settings.title ?? SITE_NAME),
	siteUrl: Astro.url.origin,
	path: "/",
});
---

<Base
	title={seo.title}
	description={seo.description}
	canonical={seo.canonical}
	content={{ collection: "home", id: home.data.id, slug: SLUG }}
	footerOnder={layout.footer.onder}
	kolom={layout.kolom === true}
>
	<Pagina layout={layout} entry={home} slug={SLUG} staticUrl={leesStaticUrl()} />
</Base>
