{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "benefitgym",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	// The site only answers on its custom domain, which sits behind Cloudflare Access.
	"workers_dev": false,
	"preview_urls": false,
	"routes": [{ "pattern": "staging.benefitgym.nl", "custom_domain": true }],
	"vars": {
		"EMDASH_SITE_URL": "https://staging.benefitgym.nl",
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "benefitgym-site",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "benefitgym-media",
		},
	],
	// Outgoing mail through Cloudflare Email Sending.
	"send_email": [{ "name": "EMAIL" }],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans.
	"worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
